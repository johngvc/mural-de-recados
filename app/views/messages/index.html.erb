<section class="section">
  <div class="container">
    <h1 class="title">Mural de recados do Rails Girls</h1>
    <%= render "form", message: @message, submit_text: "Postar recado" %>

    <div class="buttons">
      <%= link_to "Todos", root_path, class: "button is-small #{'is-dark' if params[:color].blank?}" %>
      <% [ [ "Amarelo", "yellow" ], [ "Rosa", "pink" ], [ "Azul", "blue" ], [ "Verde", "green" ] ].each do |name, color| %>
        <%= link_to name, root_path(color: color), class: "button is-small card-#{color} #{'is-dark' if params[:color] == color}" %>
      <% end %>
    </div>

    <% if @messages.empty? %>
      <% if params[:color].present? %>
        <p>Nenhum recado com essa cor.</p>
      <% else %>
        <p>Ainda não tem nenhum recado. Que tal postar o primeiro?</p>
      <% end %>
    <% end %>

    <div class="columns is-multiline">
      <% @messages.each do |message| %>
        <div class="column is-one-quarter">
          <div class="card card-<%= message.color %>">
            <div class="card-content">
              <p><%= message.content %></p>
              <p class="is-italic">— <%= message.author %></p>
              <p class="is-size-7"><%= message.created_at.strftime("%d/%m/%Y às %H:%M") %></p>
              <div class="buttons mt-4">
                <%= link_to "Editar", edit_message_path(message), class: "button is-small" %>
                <%= button_to "Apagar", message, method: :delete, class: "button is-small is-danger", form: { data: { turbo_confirm: "Quer mesmo apagar este recado?" } } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
